# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# (avoid "$" in values: Docker Compose and django-environ both treat it as a variable)

SITE_NAME=Polymath TMD
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Colombo
LOG_LEVEL=INFO

# ---- MySQL ---------------------------------------------------------------------
# Used by Django and by the MySQL container (compose.yaml), so set them once here.
MYSQL_DATABASE=polymath_tmd
MYSQL_USER=polymath
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# Where Django connects when run outside Docker. Inside Docker, compose sets DB_HOST=db.
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Docker Compose ----------------------------------------------------------
WEB_PORT=8000
WEB_CONCURRENCY=3
# False only when running the production image locally without TLS.
USE_HTTPS=False

# ---- Email ---------------------------------------------------------------------
# The dev stack always prints mail to the console (dev.py) and tests use memory (test.py).
# These apply to the production image. For a local run of the prod image, use the console
# backend so no real mail is sent:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# Secret. Never logged or shown.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# The sender on every email the app sends.
DEFAULT_FROM_EMAIL=tmd@example.com

# ---- Zoom link requests -------------------------------------------------------
# Who makes the Zoom link:
#   zoom   - the app makes the meeting through the Zoom API and checks Zoom for clashes first.
#            Production uses this. Needs every paid account's connection details in
#            zoom-credentials.env (copy zoom-credentials.env.example; see the README).
#   manual - IT creates the meeting in Zoom and pastes the link. The fallback: it can't see
#            meetings made directly in Zoom (check --deploy warns with zoom.W001).
#   fake   - dev only: makes links that don't work. The production image refuses to start
#            with it. For a dev-only .env you may use:  ZOOM_PROVIDER=fake
ZOOM_PROVIDER=manual
# The Zoom connection details (ZOOM_CREDENTIAL_SETS and ZOOM_S2S_*) do NOT go in this file:
# they live in zoom-credentials.env, which compose loads into the web container.
# How many reverse proxies sit in front of the app and add to X-Forwarded-For.
# 0 = use the direct client address (local runs). Behind the TLS proxy in production: 1.
TRUSTED_PROXY_COUNT=0
# Required. Fernet key(s) that encrypt Zoom host keys in the database, comma-separated.
# The first key encrypts; every key listed can decrypt. Keep it apart from SECRET_KEY and
# back it up: losing every key means re-typing all host keys on the Zoom accounts page.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put a new key first, restart, run "manage.py rotate_host_keys", then remove the
# old key and restart.
HOST_KEY_ENCRYPTION_KEYS=change-me-generate-a-fernet-key

# ---- Production ---------------------------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://tmd.example.com
