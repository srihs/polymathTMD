# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# (avoid "$" in values: Docker Compose and django-environ both treat it as a variable)

SITE_NAME=Polymath TMD
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Colombo
LOG_LEVEL=INFO

# ---- MySQL ---------------------------------------------------------------------
# Used by Django and by the MySQL container (compose.yaml), so set them once here.
MYSQL_DATABASE=polymath_tmd
MYSQL_USER=polymath
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# Where Django connects when run outside Docker. Inside Docker, compose sets DB_HOST=db.
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Docker Compose ----------------------------------------------------------
WEB_PORT=8000
WEB_CONCURRENCY=3
# False only when running the production image locally without TLS.
USE_HTTPS=False

# ---- Production ---------------------------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://tmd.example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=tmd@example.com
