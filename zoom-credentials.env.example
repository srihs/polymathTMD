# Zoom connection details (brief 006). Copy to zoom-credentials.env, next to .env, and fill in.
# NEVER commit zoom-credentials.env: it is git-ignored and kept out of the Docker image.
# compose.yaml loads it into the web container (env_file); recreate web after editing it:
#   docker compose up -d
# One Server-to-Server OAuth app per paid Zoom subscription; the README's "Connecting to Zoom"
# says where each value is on marketplace.zoom.us. No "$" in any value (Compose would read it
# as a variable).
#
# Each set has a name ("slug"): lower-case letters, numbers and hyphens, like zoom-01. Type the
# same name in "Zoom connection name" on that account's page in the app. The variable names
# come from the slug upper-cased, with "-" turned into "_": zoom-01 -> ZOOM_S2S_ZOOM_01_...
# For more sets, add each slug to the list and copy the three lines below for it.

# Every set's slug, comma-separated, like: zoom-01,zoom-02
ZOOM_CREDENTIAL_SETS=

# zoom-01: the "Account ID" on the app's App Credentials page.
ZOOM_S2S_ZOOM_01_ACCOUNT_ID=
# zoom-01: the "Client ID" on the same page.
ZOOM_S2S_ZOOM_01_CLIENT_ID=
# zoom-01: the "Client Secret" on the same page. Secret: never share or log it.
ZOOM_S2S_ZOOM_01_CLIENT_SECRET=
